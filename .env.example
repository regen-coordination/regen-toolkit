# .env.example — Regen Web3 Toolkit environment configuration
# Copy to .env and fill in values: cp .env.example .env
# .env is gitignored. Never commit real credentials — TOOLS.md keeps references, not secrets.

# Notion API key (for script-based Notion access)
# Get yours: https://www.notion.so/profile/integrations → create integration → copy key
# Then share your Notion databases with the integration
# Optional if using Claude Code/Cursor (MCP handles auth automatically)
NOTION_API_KEY=

# ── Linear (task sync — scripts/linear/*) ────────────────────────────────────
# Personal API key: linear.app → Settings → Security & access → Personal API keys
#
# SECURITY: on Linear's free plan every member is an admin, and a personal API key carries
# the full permissions of the person who made it. Prefer a dedicated bot identity if the plan
# allows one. Keep runs local; do not put this key in CI until it is properly scoped.
#
# Only `npm run linear:apply --confirm` writes anything. linear:plan and linear:verify are
# read-only, and there is no delete path anywhere in the pipeline.
LINEAR_API_KEY=

# Team key as it appears in issue identifiers, e.g. TOOL in TOOL-42.
LINEAR_TEAM_KEY=

# ── AT Proto publication plane (org-os-kms) ──────────────────────────────────
# App password for the instance's AT Proto account (create an *app* password, never the main one).
# Read ONLY from the environment by org-os-kms; never written to any file. Not needed while
# this instance is pull-only (publish.static/apply are false and atproto.did is null).
ATPROTO_APP_PASSWORD=
