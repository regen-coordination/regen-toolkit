{
  "lexicon": 1,
  "id": "xyz.regencoordination.kb.implementationRecord",
  "defs": {
    "main": {
      "type": "record",
      "key": "any",
      "record": {
        "type": "object",
        "required": [
          "title",
          "type",
          "source_position"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string"
          },
          "maturity": {
            "type": "string",
            "knownValues": [
              "raw",
              "held",
              "draft",
              "candidate",
              "source-linked",
              "reviewed",
              "field-informed",
              "pattern-generating",
              "deprecated",
              "archived"
            ]
          },
          "public_use": {
            "type": "string",
            "knownValues": [
              "internal-only",
              "raw-lead",
              "ok-with-caveat",
              "source-linked-unreviewed",
              "reviewed-for-explanation",
              "reviewed-for-guidance",
              "requires-community-consent",
              "requires-domain-review",
              "not-public-yet",
              "deprecated"
            ]
          },
          "lifecycle_state": {
            "type": "string",
            "knownValues": [
              "raw-lead",
              "routed",
              "extracted",
              "source-linked",
              "ai-synthesis",
              "human-reviewed",
              "field-informed",
              "public-candidate",
              "mature",
              "compost"
            ]
          },
          "ai_assisted": {
            "type": "boolean"
          },
          "high_risk": {
            "type": "boolean"
          },
          "domain": {
            "type": "string"
          },
          "function": {
            "type": "string"
          },
          "source_lineage": {
            "type": "string"
          },
          "steward": {
            "type": "string"
          },
          "review_needs": {
            "type": "string"
          },
          "last_reviewed": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "grc20Id": {
            "type": "string"
          },
          "sourceUri": {
            "type": "string"
          },
          "viaUri": {
            "type": "string"
          },
          "related_deployment": {
            "type": "string"
          },
          "related_track": {
            "type": "string"
          },
          "context": {
            "type": "string"
          },
          "source_position": {
            "type": "string",
            "knownValues": [
              "self-report",
              "participant-reflection",
              "funder-review",
              "community-member",
              "affected-community",
              "third-party-observer",
              "public-forum",
              "grant-update",
              "ai-assisted-synthesis",
              "anonymous-or-restricted"
            ]
          },
          "what_worked": {
            "type": "string"
          },
          "what_failed": {
            "type": "string"
          },
          "adaptations": {
            "type": "string"
          },
          "what_returns_to_commons": {
            "type": "string"
          },
          "record_type": {
            "type": "string",
            "knownValues": [
              "pilot",
              "campaign",
              "funding-round",
              "governance",
              "local-node",
              "knowledge-commons",
              "ecological-mrv",
              "event",
              "failure-case"
            ]
          },
          "record_stage": {
            "type": "string",
            "knownValues": [
              "prospective",
              "in-progress",
              "retrospective"
            ]
          }
        }
      }
    }
  }
}
