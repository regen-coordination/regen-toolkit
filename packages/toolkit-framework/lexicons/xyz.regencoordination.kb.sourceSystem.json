            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "what_it_curates": {
            "type": "string"
          },
          "why_it_matters": {
            "type": "string"
          },
          "how_to_credit": {
            "type": "string"
          },
          "use_type": {
            "type": "string"
          },
          "reuse_conditions": {
            "type": "string"
          },
          "return_path": {
            "type": "string"
          },
          "currentness": {
            "type": "string"
          },
          "update_rhythm": {
            "type": "string"
          },
          "extraction_status": {
            "type": "string"
          },
          "toolkit_route": {
            "type": "string"
          }
        }
