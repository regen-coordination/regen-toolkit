          },
          "ai_assisted": {
            "type": "boolean"
          },
          "high_risk": {
            "type": "boolean"
          },
          "domain": {
            "type": "string"
          },
          "function": {
            "type": "string"
          },
          "source_lineage": {
            "type": "string"
          },
          "steward": {
            "type": "string"
          },
          "review_needs": {
            "type": "string"
          },
          "last_reviewed": {
            "type": "string"
          },
          "notes": {
            "type": "string"
          },
          "id": {
            "type": "string"
          },
          "grc20Id": {
            "type": "string"
          },
          "sourceUri": {
            "type": "string"
          },
