        "properties": {
          "title": {
            "type": "string"
          },
          "type": {
            "type": "string",
            "knownValues": [
              "wiki",
              "map",
              "repo",
              "forum",
              "knowledge-garden",
              "directory",
              "archive",
              "database",
              "library",
              "docs-site",
              "convening",
              "podcast",
              "newsletter",
              "dataset",
              "blog",
              "publication",
              "organization",
              "movement",
              "platform"
            ]
          },
          "maturity": {
            "type": "string",
            "knownValues": [
              "raw",
              "held",
              "draft",
              "candidate",
              "source-linked",
              "reviewed",
              "field-informed",
              "pattern-generating",
              "deprecated",
              "archived"
            ]
          },
          "public_use": {
            "type": "string",
            "knownValues": [
              "internal-only",
              "raw-lead",
              "ok-with-caveat",
              "source-linked-unreviewed",
              "reviewed-for-explanation",
              "reviewed-for-guidance",
              "requires-community-consent",
              "requires-domain-review",
              "not-public-yet",
              "deprecated"
            ]
          },
          "lifecycle_state": {
            "type": "string",
            "knownValues": [
              "raw-lead",
              "routed",
              "extracted",
              "source-linked",
              "ai-synthesis",
              "human-reviewed",
              "field-informed",
              "public-candidate",
              "mature",
              "compost"
